# Local host-only settings. Copy to .env.local and edit values when needed.
# These values are for local testing only.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-local-host-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TIME_ZONE=Europe/Moscow

POSTS_PER_PAGE=20
MAX_UPLOAD_SIZE=5242880
MAX_REMOTE_IMAGE_SIZE=5242880
REMOTE_IMAGE_TIMEOUT=5

# Auto-created local admin user. Change before first bootstrap if needed.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.local
DJANGO_SUPERUSER_PASSWORD=admin12345

# Set True only if you want bootstrap to overwrite the local admin password.
LOCAL_RESET_ADMIN_PASSWORD=False

# Optional runserver bind address.
DJANGO_RUNSERVER_ADDR=127.0.0.1:8000
