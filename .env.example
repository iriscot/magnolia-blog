# Local Docker-only settings. Copy to .env and edit values when needed.
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=django-insecure-local-docker-only-change-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
DJANGO_TIME_ZONE=Europe/Moscow
POSTS_PER_PAGE=20
MAX_UPLOAD_SIZE=5242880
MAX_REMOTE_IMAGE_SIZE=5242880
REMOTE_IMAGE_TIMEOUT=5

# Auto-created local admin user.
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.local
DJANGO_SUPERUSER_PASSWORD=admin12345
